# ---- ROOT .env.example (local docker compose) ----
# Copy to .env :  cp .env.example .env   (Windows:  copy .env.example .env)
# Only override what you need — compose has working defaults for everything.

# Any random 32+ char string. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=local-dev-secret-please-change-0000000000

# Seed synthetic data on first backend start (2 communities, towers, units, demo users).
SEED_ON_START=true

# Email. 'console' just logs. Set 'brevo' + key to actually send.
EMAIL_BACKEND=console
BREVO_API_KEY=
EMAIL_FROM=no-reply@gatesphere.com

# Host port mappings. Change any that clash with something already running on your machine
# (e.g. a local Postgres on 5432). Container-internal ports never change.
DB_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8000
WEB_PORT=3000
