# ---- backend/.env.example ----  copy to backend/.env for bare-metal runs.
# When using docker compose these are provided by the root .env / compose file.
ENVIRONMENT=local
DEBUG=true
SECRET_KEY=change-me-to-a-random-32+char-string-0000
PROJECT_NAME=GateSphere

FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800

DATABASE_URL=postgresql+psycopg://gatesphere:gatesphere@localhost:5432/gatesphere
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=gatesphere
S3_SECRET_KEY=gatesphere-secret
S3_BUCKET=gatesphere-local
S3_REGION=us-east-1

# Email: 'console' logs messages; 'brevo' sends for real (needs BREVO_API_KEY).
EMAIL_BACKEND=console
BREVO_API_KEY=
EMAIL_FROM=no-reply@gatesphere.com
EMAIL_FROM_NAME=GateSphere

SEED_ON_START=false
