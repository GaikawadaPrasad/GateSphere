# ---- frontend/.env.example ---- copy to frontend/.env.local for bare-metal `npm run dev`.
# With docker compose this is set by the compose file.

# Where Next.js rewrites /api/* to. In compose this is the backend service DNS name.
BACKEND_INTERNAL_URL=http://localhost:8000
NEXT_TELEMETRY_DISABLED=1
# Optional explicit realtime WebSocket URL. Default: same origin /api/v1/realtime/ws
# (the /api rewrite above also proxies the WebSocket upgrade).
# NEXT_PUBLIC_REALTIME_URL=ws://localhost:8000/api/v1/realtime/ws
